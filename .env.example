# OJO: usa el "Connection Pooler" de Supabase (Project Settings → Database →
# Connect → "Transaction pooler"), NO el host directo db.[PROJECT-REF].supabase.co.
# El host directo solo resuelve por IPv6, y Vercel (y la mayoría de plataformas
# serverless) no tiene salida IPv6 — cualquier ruta que toque la base tira 500
# en producción aunque funcione perfecto en local. Puerto 6543, usuario
# postgres.[PROJECT-REF] (con un punto, no dos-puntos).
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[YOUR-ANON-KEY]
PLATFORM_ADMIN_EMAILS=tu-email@ejemplo.com

# Cobro automático por QR (Infinity Payments) — proveedor activo por ahora.
# Mientras INFINITY_API_KEY no esté seteada, el checkout sigue usando el QR
# estático que cada vendedor sube a mano, sin ningún cambio. Usa ik_test_...
# para probar en sandbox y ik_live_... recién cuando quieras cobrar de verdad
# (nunca al revés — con ik_test_... en producción los pedidos jamás cobran).
# Host actual del proveedor (mismo dueño, mismas credenciales que antes de
# api.infinityeventapp.com). Ojo: en este dominio los endpoints van bajo
# /api (probado: /payments/create da 404, /api/payments/create da 200).
INFINITY_BASE_URL=https://apipayments.deviajeapp.com/api
INFINITY_API_KEY=
# Secreto elegido por Infinity (no por vos) para firmar el webhook — se usa
# para verificar X-Infinity-Signature en /api/webhooks/infinity.
INFINITY_WEBHOOK_SECRET=

# Cobro automático por QR (SIP / Banco BISA) — respaldo, no está activo
# mientras Infinity Payments esté configurado (ver arriba). Mientras estas
# variables no estén seteadas, no tiene ningún efecto. Se obtienen al
# registrarse con el banco (ver README → "Siguiente paso técnico").
SIP_BASE_URL=https://dev-sip.mc4.com.bo:8443
SIP_APIKEY=
SIP_USERNAME=
SIP_PASSWORD=
# Llave del servicio de SIP asociado a LA CUENTA DE DCOMPRAS (no una por
# tienda: el cobro es centralizado — la plata entra acá, se le descuenta la
# comisión, y el resto se liquida al vendedor). Se crea en el dashboard de
# SIP → Servicios → Adicionar, apuntando a la cuenta bancaria de Dcompras.
SIP_APIKEY_SERVICIO=
# Credenciales que vos elegís (no las que da el banco) para que SIP te
# confirme los pagos por este endpoint: /api/webhooks/sip/confirmar-pago
# La contraseña debe tener mayúscula, minúscula y un carácter especial.
SIP_CALLBACK_USER=
SIP_CALLBACK_PASSWORD=
# Opcional: solo hace falta si el dominio público no se detecta bien solo
# (por ejemplo, detrás de cierto tipo de proxy). Si no lo pones, se usa el
# origen de la request automáticamente.
PUBLIC_APP_URL=

# Comisión de Dcompras por venta pagada con QR automático (%). Arrancamos en 1
# — ver el roadmap de pagos para el porqué. Solo aplica a pedidos que pasan
# por la cuenta de Dcompras; contra entrega nunca tiene comisión.
COMMISSION_PERCENT=1
